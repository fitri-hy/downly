<!DOCTYPE html>
<html lang="en">
<head>
  <title>Downly - Download Videos & Audio Easily</title>
  <meta name="description" content="Downly is a fast and easy platform to download videos or audio from various popular platforms.">
  <meta name="keywords" content="Downly, download video, download audio, YouTube downloader, TikTok downloader, Instagram downloader, fast video download, free video downloader">
  <meta property="og:title" content="Downly - Download Videos & Audio Easily" />
  <meta property="og:description" content="Downly is a fast and easy platform to download videos or audio from various popular platforms." />
  <meta name="twitter:title" content="Downly - Download Videos & Audio Easily" />
  <meta name="twitter:description" content="Downly is a fast and easy platform to download videos or audio from various popular platforms." />
  <%- include('partials/head') %>
</head>
<body class="flex flex-col w-full min-h-screen bg-gradient-to-br from-slate-50 via-gray-50 to-sky-50/50 text-neutral-700 dark:text-neutral-100 dark:from-neutral-900 dark:via-gray-900 dark:to-slate-900">
	<div class="-z-10 fixed top-0 h-[100vh] inset-0 bg-[linear-gradient(to_right,#94a3b82e_1px,transparent_1px),linear-gradient(to_bottom,#94a3b82e_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#4755692e_1px,transparent_1px),linear-gradient(to_bottom,#4755692e_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
	
	<%- include('components/header') %>
	<main class="flex flex-col items-center p-4">
		<section class="container mx-auto pt-4 md:pt-9">
			
			<div class="mb-6">
				<h1 class="tracking-tight flex flex-col text-center text-3xl md:text-5xl font-extrabold text-black dark:text-white max-w-xl mx-auto">
					<span class="bg-gradient-to-r from-sky-500 to-blue-500 bg-clip-text text-transparent">
						Fast Download
					</span>
					Everything is Yours
				</h1>
				<p class="text-sm md:text-base max-w-lg mx-auto text-center mt-4 md:mt-6">
					Downly is a fast and easy platform to download videos or audio from various popular platforms.
				</p>
				<% if (!session.user) { %>
				<div class="flex justify-center mt-2">
					<a href="/register" class="flex items-center gap-1 text-center text-lg font-semibold text-blue-500 underline">
						Try Now Free Plan
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6m0 0H9m9 0v9"/></svg>
					</a>
				</div>
				<% } %>
			</div>
			<% if (!session.user) { %>
			<form id="downloadForm" action="/downloads" method="POST" class="text-sm md:text-base flex flex-col md:flex-row md:items-center gap-4 md:gap-0 max-w-lg mx-auto">
				<div class="w-full flex">
					<div class="w-full flex-1">
						<input type="url" id="url" name="url" placeholder="Paste URL here ..." required class="w-full px-3 py-3 rounded-l bg-white dark:bg-slate-700 border-l border-t border-b border-neutral-200 dark:border-slate-800 focus:outline-none">
					</div>
					<div class="">
						<select name="type" id="type" required class="px-3 py-[0.8rem] md:py-3.5 rounded-r md:rounded-none bg-white dark:bg-slate-700 border border-neutral-200 dark:border-slate-800 focus:outline-none">
						  <option value="video">Video</option>
						  <option value="audio">Audio</option>
						</select>
					</div>
				</div>
				<div class="flex justify-center">
					<button type="submit" class="flex items-center gap-2 bg-blue-500 dark:bg-blue-600 font-semibold text-white rounded md:rounded-l-none px-3 py-3 hover:scale-105 hover:duration-300 hover:transition-all hover:shadow-lg">
						<span class="flex md:hidden">Download</span>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15c0 2.828 0 4.243.879 5.121C4.757 21 6.172 21 9 21h6c2.828 0 4.243 0 5.121-.879C21 19.243 21 17.828 21 15M12 3v13m0 0l4-4.375M12 16l-4-4.375"/></svg>
					</button>
				</div>
			</form>
			<% } else { %>
				<div class="flex justify-center">
					<a href="/dashboard" class="bg-gradient-to-r text-lg from-sky-500 dark:from-sky-600 to-indigo-500 dark:to-indigo-600 flex items-center gap-2 rounded-full px-4 py-2 text-white font-semibold hover:shadow-lg hover:scale-105 hover:duration-all transition-all">
						Start Download
					</a>
				</div>
			<% } %>
			
			<% if (downloads.length > 0) { %>
			<div class="prose prose-sm md:prose-base dark:prose-invert max-w-none mt-12">
				<h2 class="text-lg font-bold tracking-tight -mb-4">Download History</h2>
				<div class="overflow-auto w-full">
					<table class="w-full border-collapse">
						<thead>
							<tr>
								<th>Title</th>
								<th>Type</th>
								<th class="text-center">Expired</th>
								<th class="text-center">Action</th>
							</tr>
						</thead>
						<tbody id="downloads-list">
							<% downloads.forEach((d) => { %>
								<tr 
									<% if (d.expired_at) { %> 
									data-expired="<%= new Date(d.expired_at).toISOString() %>"
									<% } else { %>
									data-expired="lifetime"
									<% } %>
								>
									<td>
										<div class="w-full min-w-[36px] overflow-hidden line-clamp-1 text-lg">
											<%= d.title %>
										</div>
									</td>

									<td class="whitespace-nowrap">
										<%= d.type.charAt(0).toUpperCase() + d.type.slice(1) %>
									</td>

									<td class="countdown text-rose-500 font-semibold whitespace-nowrap text-center">
										00:00:00
									</td>

									<td class="whitespace-nowrap">
										<div class="flex items-center justify-center gap-2">
											<a class="text-sky-500" href="<%= d.filepath %>" download>
											<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15c0 2.828 0 4.243.879 5.121C4.757 21 6.172 21 9 21h6c2.828 0 4.243 0 5.121-.879C21 19.243 21 17.828 21 15M12 3v13m0 0l4-4.375M12 16l-4-4.375"/></svg>
											</a>

											<button type="button" class="text-emerald-500" onclick="window.open('<%= d.filepath %>', '_blank')">
											<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3.275 15.296C2.425 14.192 2 13.639 2 12c0-1.64.425-2.191 1.275-3.296C4.972 6.5 7.818 4 12 4s7.028 2.5 8.725 4.704C21.575 9.81 22 10.361 22 12c0 1.64-.425 2.191-1.275 3.296C19.028 17.5 16.182 20 12 20s-7.028-2.5-8.725-4.704Z"/><path d="M15 12a3 3 0 1 1-6 0a3 3 0 0 1 6 0Z"/></g></svg>
											</button>

											<form action="/downloads/delete/<%= d.id %>" method="POST" class="-mb-1">
												<button type="submit" class="text-rose-500">
												<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" d="M9.17 4a3.001 3.001 0 0 1 5.66 0m5.67 2h-17m15.333 2.5l-.46 6.9c-.177 2.654-.265 3.981-1.13 4.79s-2.196.81-4.856.81h-.774c-2.66 0-3.991 0-4.856-.81c-.865-.809-.954-2.136-1.13-4.79l-.46-6.9M9.5 11l.5 5m4.5-5l-.5 5"/></svg>
											</button>
											</form>
										</div>
									</td>
								</tr>
							<% }) %>
						</tbody>
					</table>
				</div>
			</div>
			<% } %>
		</section>
		<section class="w-full max-w-6xl mx-auto pt-16">
			<div class="flex flex-col justify-center items-center">
				<h2 class="tracking-tight text-2xl md:text-3xl font-semibold text-black dark:text-white">
					Support Platforms
				</h2>
			</div>
			<div class="flex flex-wrap justify-center gap-4 mt-9">
				<div class="bg-white dark:bg-slate-700 px-4 py-2 rounded-md shadow-sm flex items-center gap-2">
