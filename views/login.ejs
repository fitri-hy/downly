<!DOCTYPE html>
<html lang="en">
<head>
  <title>Sign In - Downly</title>
  <meta name="description" content="Login to your Downly account to access saved downloads and manage your preferences easily.">
  <meta name="keywords" content="Downly login, user login, account access, video downloader account">
  <meta property="og:title" content="Login - Downly" />
  <meta property="og:description" content="Access your Downly account to manage your downloads and preferences easily." />
  <meta name="twitter:title" content="Login - Downly" />
  <meta name="twitter:description" content="Access your Downly account to manage your downloads and preferences easily." />
  <%- include('partials/head') %>
  <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>
</head>
<body class="flex flex-col justify-center items-center w-full min-h-screen bg-gradient-to-br from-slate-50 via-gray-50 to-sky-50/50 text-neutral-700 p-4 dark:text-neutral-100 dark:from-neutral-900 dark:via-gray-900 dark:to-slate-900">
	<div class="-z-10 fixed top-0 h-[100vh] inset-0 bg-[linear-gradient(to_right,#94a3b82e_1px,transparent_1px),linear-gradient(to_bottom,#94a3b82e_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#4755692e_1px,transparent_1px),linear-gradient(to_bottom,#4755692e_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>

	<main class="relative flex flex-col items-center justify-center w-full max-w-sm bg-white dark:bg-slate-800 px-6 py-9 rounded-lg shadow-lg border-b-4 border-blue-500 dark:border-blue-600">
		
		<div class="absolute top-4 right-4 z-50">
			<%- include('components/dark-button') %>
		</div>
		
		<a href="/">
			<img src="/assets/images/logo.png" alt="logo" class="h-20 w-20 object-cover mb-4 drop-shadow-md" />
		</a>
		<div class="flex flex-col gap-1 items-center mb-6">
			<h1 class="text-2xl font-semibold tracking-tight text-center">
				Sign In
			</h1>
			<p class="text-center">
				Log in to your account
			</p>
		</div>
		<form action="/login" method="POST" class="w-full flex flex-col gap-4 max-w-xs mx-auto mb-6">
			<div class="flex flex-col gap-1">
				<label class="text-sm">Email</label>
				<input type="email" name="email" placeholder="Enter your email" required class="w-full p-3 rounded bg-neutral-50 dark:bg-slate-700 focus:outline-none border border-neural-100 dark:border-slate-600">
			</div>
			<div class="flex flex-col gap-1">
				<label class="text-sm">Password</label>
				<input type="password" name="password" placeholder="Enter your password" required class="w-full p-3 rounded bg-neutral-50 dark:bg-slate-700 focus:outline-none border border-neural-100 dark:border-slate-600">
			</div>
			<% if (recaptcha) { %>
				<%- recaptcha.render() %>
			<% } %>
			<div class="flex justify-center mt-2">
				<button type="submit" class="flex items-center gap-2 px-4 py-2 bg-blue-500 dark:bg-blue-600 text-white font-semibold rounded hover:shadow-lg hover:scale-105 hover:duration-300 hover:transition-all">
					<span>Login</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"><path d="M12 20a8 8 0 1 0 0-16"/><path stroke-linejoin="round" d="M4 12h10m0 0l-3-3m3 3l-3 3"/></g></svg>
				</button>
			</div>
		</form>
		<% if (useGoogleAuth) { %>
			<form id="googleLoginForm" action="/login-google" method="POST" class="mb-6">
				<input type="hidden" name="idToken" id="idTokenInput" />
				<button type="button" id="btnGoogleLogin" class="mt-4 flex items-center gap-2 border rounded-md px-3 py-2 border-gray-300 dark:border-slate-600 text-sm hover:bg-gray-50 dark:hover:bg-slate-700/60 hover:duration-300 transition-all">
				  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 256 262"><path fill="#4285f4" d="M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622l38.755 30.023l2.685.268c24.659-22.774 38.875-56.282 38.875-96.027"/><path fill="#34a853" d="M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055c-34.523 0-63.824-22.773-74.269-54.25l-1.531.13l-40.298 31.187l-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1"/><path fill="#fbbc05" d="M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82c0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602z"/><path fill="#eb4335" d="M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0C79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251"/></svg>
				  <span>Log in with Google</span>
				</button>
			</form>
		<% } %>
		<span class="text-center">
			Don't have an account?
			<a href="/register" class="text-blue-500 hover:underline">
				Sign Up
			</a>
		</span>
	</main>
  
	<%- include('components/error-modal') %>
	<script src="/assets/js/app.js"></script>
	<% if (useGoogleAuth) { %>
    <script>
    const firebaseConfig = <%- JSON.stringify(firebaseConfig) %>;
    firebase.initializeApp(firebaseConfig);
    const auth = firebase.auth();

    const form = document.getElementById('googleLoginForm');
    const btn = document.getElementById('btnGoogleLogin');
    const idTokenInput = document.getElementById('idTokenInput');

	btn.addEventListener('click', async () => {
	  const provider = new firebase.auth.GoogleAuthProvider();
	  try {
		const result = await auth.signInWithPopup(provider);
		const idToken = await result.user.getIdToken();

		const res = await fetch('/login-google', {
		  method: 'POST',
		  headers: { 'Content-Type': 'application/json' },
		  body: JSON.stringify({ idToken })
		});

		if (res.redirected) {
		  window.location.href = res.url;
		} else {
		  const data = await res.json();
		  console.error('Failed:', error);
		}
	  } catch (error) {
		console.error('Failed:', error);
		window.location.href = res.url;
	  }
	});

	</script>
	<% } %>
</body>
</html>
