						</li>
					</ul>
				</div>
				<div class="flex justify-center items-center mt-6">
					<% 
					  const formattedPrice = Number(pkg.price).toLocaleString('id-ID', { minimumFractionDigits: 0 });
					  const waMessage = encodeURIComponent(`Hello, I am interested in the Package: *${pkg.name}* Price: *Rp ${formattedPrice}*. Source: https://downly.cloud`);
					%>
					<a href="https://wa.me/6281525977595?text=<%= waMessage %>" target="_blank" class="buy-now-btn bg-gradient-to-r text-lg from-sky-500 dark:from-sky-600 to-indigo-500 dark:to-indigo-600 flex items-center gap-2 rounded-full px-4 py-2 text-white font-semibold hover:shadow-lg hover:scale-105 hover:duration-all transition-all">
