<section class="p-4">
	<% 
		const now = new Date();
		let expired = false;
		let quotaHabis = false;
		subscriptions.forEach(s => {
		if (s.expired_at && new Date(s.expired_at) < now) expired = true;
		if (!s.isUnlimited && (!s.remaining_quote || s.remaining_quote <= 0)) quotaHabis = true;
		});
	%>
	<% if (subscriptions.length === 0 || expired) { %>
		<div class="w-full flex flex-col gap-2 pt-12">
			<h2 class="text-3xl md:text-4xl text-center font-bold tracking-tight text-black dark:text-white">
				Subscribe Now
			</h2>
			<p class="text-center mx-auto max-w-md">
				Your package has expired or does not have an active package!
			</p>
		</div>
		<div class="mt-9 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
			<% if (packages && packages.length > 0) { %>
			<% packages.forEach(pkg => { %>
			<% if (pkg.name !== 'ADMIN') { %>
			<div class="hover:scale-105 hover:shadow-xl hover:duration-300 hover:transition-all flex flex-col justify-between gap-2 bg-white dark:bg-slate-800 p-4 rounded-lg shadow-md">
				<div class="flex flex-col gap-2">
					<h3 class="text-xl font-bold">
						<%= pkg.name %>
					</h3>
					<h4 class="text-4xl font-extrabold">
						<span class="tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-sky-500 to-blue-500">
							<% if (Number(pkg.price) === 0) { %>
							  Free
							<% } else { %>
								<%= Number(pkg.price).toLocaleString('id-ID', { minimumFractionDigits: 0 }) %>
							<% } %>
						</span>
						<span class="text-sm font-semibold">
							/ <%= pkg.duration %> days
						</span>
					</h4>
				</div>
				<div>
					<ul class="mt-2 px-2">
						<li class="flex items-center gap-2">
							<span class="font-semibold"><%= pkg.quote %></span>
							Quota Download
						</li>
						<li class="flex items-center gap-2">
							<span class="font-semibold"><%= pkg.file_expired %></span> Minute
							Expired File
						</li>
						<li class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m4 12.9l3.143 3.6L15 7.5m5 .063l-8.572 9L11 16"></path></svg>
							Youtube
						</li>
						<li class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m4 12.9l3.143 3.6L15 7.5m5 .063l-8.572 9L11 16"></path></svg>
							Facebook
