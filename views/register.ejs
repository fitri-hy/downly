<!DOCTYPE html>
<html lang="en">
<head>
  <title>Sign Up - Downly</title>
  <meta name="description" content="Create your Downly account to start downloading videos and audio easily from popular platforms.">
  <meta name="keywords" content="Downly register, create account, sign up, video downloader account">
  <meta property="og:title" content="Register - Downly" />
  <meta property="og:description" content="Create your Downly account to start downloading videos and audio easily from popular platforms." />
  <meta name="twitter:title" content="Register - Downly" />
  <meta name="twitter:description" content="Create your Downly account to start downloading videos and audio easily from popular platforms." />
  <%- include('partials/head') %>
</head>
<body class="flex flex-col justify-center items-center w-full min-h-screen bg-gradient-to-br from-slate-50 via-gray-50 to-sky-50/50 text-neutral-700 p-4 dark:text-neutral-100 dark:from-neutral-900 dark:via-gray-900 dark:to-slate-900">
	<div class="-z-10 fixed top-0 h-[100vh] inset-0 bg-[linear-gradient(to_right,#94a3b82e_1px,transparent_1px),linear-gradient(to_bottom,#94a3b82e_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#4755692e_1px,transparent_1px),linear-gradient(to_bottom,#4755692e_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>

	<main class="relative flex flex-col items-center justify-center w-full max-w-sm bg-white dark:bg-slate-800 px-6 py-9 rounded-lg shadow-lg border-b-4 border-blue-500 dark:border-blue-600">
		
		<div class="absolute top-4 right-4 z-50">
			<%- include('components/dark-button') %>
		</div>

		<a href="/">
			<img src="/assets/images/logo.png" alt="logo" class="h-20 w-20 object-cover mb-4 drop-shadow-md" />
		</a>
		<div class="flex flex-col gap-1 items-center mb-6">
			<h1 class="text-2xl font-semibold tracking-tight text-center">
				Sign In
			</h1>
			<p class="text-center">
				Create your account
			</p>
		</div>
		<form action="/register" method="POST" class="w-full flex flex-col gap-4 max-w-xs mx-auto mb-6">
			<div class="flex flex-col gap-1">
				<label class="text-sm">Full Name</label>
				<input type="text" name="name" placeholder="Enter your name" maxlength="25" pattern="^[a-zA-Z\s]+$" required class="w-full p-3 rounded bg-neutral-50 dark:bg-slate-700 focus:outline-none border border-neural-100 dark:border-slate-600">
				<span id="nameError" class="text-rose-500 text-xs">Numbers & symbols not allowed</span>
			</div>
			<div class="flex flex-col gap-1">
				<label class="text-sm">Email</label>
				<input type="email" name="email" placeholder="Enter your email" required class="w-full p-3 rounded bg-neutral-50 dark:bg-slate-700 focus:outline-none border border-neural-100 dark:border-slate-600">
			</div>
			<div class="flex flex-col gap-1">
				<label class="text-sm">Password</label>
				<input type="password" name="password" placeholder="Enter your password" minlength="6" required class="w-full p-3 rounded bg-neutral-50 dark:bg-slate-700 focus:outline-none border border-neural-100 dark:border-slate-600">
			</div>
			<div class="flex flex-col gap-1">
				<label class="text-sm">Confirm Password</label>
				<input type="password" name="confirmPassword" placeholder="Enter confirm password" minlength="6" required class="w-full p-3 rounded bg-neutral-50 dark:bg-slate-700 focus:outline-none border border-neural-100 dark:border-slate-600">
			</div>
			<% if (recaptcha) { %>
				<%- recaptcha.render() %>
			<% } %>
			<div class="flex justify-center mt-2">
				<button type="submit" class="flex items-center gap-2 px-4 py-2 bg-blue-500 dark:bg-blue-600 text-white font-semibold rounded hover:shadow-lg hover:scale-105 hover:duration-300 hover:transition-all">
					<span>Register</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"><path d="M12 20a8 8 0 1 0 0-16"/><path stroke-linejoin="round" d="M4 12h10m0 0l-3-3m3 3l-3 3"/></g></svg>
				</button>
			</div>
		</form>
		<span class="text-center">
			Already have an account?
			<a href="/login" class="text-blue-500 hover:underline">
				Sign In
			</a>
		</span>
	</main>
  
	<%- include('components/error-modal') %>
	<script src="/assets/js/app.js"></script>
</body>
</html>