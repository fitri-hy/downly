{
  "name": "downly",
  "version": "1.0.0",
  "description": "Downly is a fast and easy platform to download videos or audio from various popular platforms.",
  "license": "MIT",
  "author": "Fhylabs Group",
  "keywords": [
    "downly",
    "video downloader",
    "audio downloader",
    "youtube downloader",
    "tiktok downloader",
    "instagram downloader",
    "facebook downloader",
    "soundcloud downloader",
    "vimeo downloader",
    "twitter downloader",
    "media downloader",
    "nodejs",
    "express",
    "streaming"
  ],
  "main": "app.js",
  "scripts": {
    "start": "npm run build:css && node app.js",
    "dev": "concurrently \"npm run watch:css\" \"nodemon app.js\"",
    "build:css": "npx postcss public/assets/css/tailwind.css -o public/assets/css/styles.css",
    "watch:css": "npx postcss public/assets/css/tailwind.css -o public/assets/css/styles.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "connect-flash": "^0.1.1",
    "dotenv": "^17.2.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-recaptcha": "^5.1.0",
    "express-session": "^1.18.2",
    "firebase-admin": "^13.4.0",
    "marked": "^16.1.2",
    "mysql2": "^3.14.3",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "ws": "^8.18.3"
  }
}
